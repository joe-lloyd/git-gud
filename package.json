{
  "name": "git-gud",
  "version": "0.1.0",
  "description": "A beautiful Git Gud inspired by GitKraken",
  "main": "out/main/index.js",
  "author": {
    "name": "Joe Lloyd",
    "email": "joelloyd@codedazur.com"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest",
    "test:repos": "bash scripts/build-test-repos.sh",
    "build:icon": "electron scripts/render-icon.cjs && bash scripts/build-icns.sh",
    "typecheck": "tsc --noEmit",
    "dist": "pnpm build && electron-builder",
    "dist:mac": "pnpm build && electron-builder --mac",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@octokit/rest": "^19.0.13",
    "electron-updater": "^6.3.9",
    "highlight.js": "^11.11.1",
    "simple-git": "^3.22.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.1.0",
    "jsdom": "^29.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "vitest": "^2.1.9"
  }
}
