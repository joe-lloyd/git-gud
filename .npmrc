# Flatten node_modules so electron-builder finds transitive runtime deps
# (e.g. fs-extra under electron-updater). pnpm's default isolated layout
# breaks packaging for some Electron tooling.
node-linker=hoisted

# Per org policy: minimum age before a published version is allowed,
# protects against snap-of-the-day supply-chain attacks.
minimum-release-age=4320
