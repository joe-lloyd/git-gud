# Copy to `.env` and fill in. `.env` is gitignored.

# GitHub Personal Access Token (classic) with `repo` scope. Used by
# `pnpm release` to upload installers to GitHub Releases.
# Generate at: https://github.com/settings/tokens
GH_TOKEN=ghp_replace_me

# GitHub OAuth App client ID — powers the in-app GitHub sign-in
# (GitHubPanel → create repo, set origin, etc.). Public value; safe in
# the bundle but kept here for parity with secret config.
# Register an OAuth app at: https://github.com/settings/developers
VITE_GITHUB_CLIENT_ID=Iv1.replace_me
