# Copy to `.env` and fill in. `.env` is gitignored.

# GitHub Personal Access Token (classic) with `repo` scope. Used by
# `pnpm release` to upload installers to GitHub Releases.
# Generate at: https://github.com/settings/tokens
GH_TOKEN=ghp_replace_me

# OPTIONAL — GitHub OAuth App client ID for the in-app GitHub sign-in.
# The app already ships with a built-in default (see src/renderer/lib/github.ts),
# so you only need this to use your own OAuth app. It's a public value.
# Register an OAuth app at: https://github.com/settings/developers
# VITE_GITHUB_CLIENT_ID=your_client_id_here
