{
  "include": ["electron.vite.config.*", "vite.headless.config.ts", "src/main/**/*", "src/preload/**/*", "src/headless/**/*", "src/relay/**/*", "packages/peer-protocol/src/**/*"],
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "out",
    "types": ["node"],
    "paths": { "@gitgud/peer-protocol": ["./packages/peer-protocol/src/index.ts"] }
  }
}
