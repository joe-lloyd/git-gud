{
  "expo": {
    "name": "Git Gud",
    "slug": "gitgud-companion",
    "version": "0.1.0",
    "scheme": "gitgud-peer",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#14151c",
    "ios": {
      "bundleIdentifier": "com.joelloyd.gitgud.companion",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan the pairing QR shown by Git Gud on your computer."
      }
    },
    "android": {
      "package": "com.joelloyd.gitgud.companion",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#14151c"
      },
      "permissions": [
        "CAMERA"
      ],
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the pairing QR shown by Git Gud on your computer."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#ff79c6"
        }
      ],
      "expo-updates"
    ],
    "extra": {
      "eas": {},
      "build": {
        "tag": "dev",
        "sha": ""
      }
    },
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
